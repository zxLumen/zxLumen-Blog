# deps
node_modules/

# builds
dist/
build/
.next/
.vinxi/
.output/
.nitro/

# env / secrets
.env
.env.local
.env.*.local

# db (local dev; prod uses docker volume)
*.db
*.db-journal
*.db-wal
*.db-shm

# os / editor
.DS_Store

# logs
*.log
npm-debug.log*

# misc
.turbo/
.vercel/
out/

# 测试产物(Playwright)
test-results/
playwright-report/
blob-report/
tests-suite/.auth/

# 个人简历(含个人信息,不入库;仅保留生成脚本 resume.py / 样式 resume.css)
apps/next-home/resume/resume.md
apps/next-home/resume/resume.html
apps/next-home/resume/resume.pdf
apps/next-home/public/resume.pdf

# 个人资料(真实内容不入库;仓库仅保留 content.local.example.ts)
packages/shared/src/content.local.ts

# 运行时站点内容(export:content 生成 + 简历/二维码副本,不入库,部署时手动上传)
docker/site-content/
# 例外:应用栏预览图 + manifest 由 scripts/app-shots.mjs 生成,随仓库部署
!docker/site-content/
docker/site-content/*
!docker/site-content/apps/
docker/site-content/apps/*
!docker/site-content/apps/shots/
!docker/site-content/apps/shots/**

# 微信二维码(个人联系方式,不入库,部署时手动上传)
apps/next-home/public/wechat.png

# 视频横屏封面(cover:vlog 生成到 docker/site-content/vlog/,不入库)
# 这里是指向它的软链,让本地 dev 也能用同一个 /vlog/<vid>.jpg 路径
apps/next-home/public/vlog

# 应用栏图标目录本身不入库;指向它的软链要入库 —— 本地 dev / CI 的 E2E 靠它
# 访问 /apps/shots/*(预览图在仓库里);线上仍由 Caddy 直接服务 site-content。
# (以前软链也被忽略,新克隆需要手动 ln -s)

docs/proxy.yaml

# 品牌原图(2048² 大文件,只归档备查;站点只用派生的优化图,不入库)
assets/brand-source/
# 服务器侧部署备份 / staging(ci-run.sh 生成,不进仓库)
docker/.deploy-backup/
docker/*.staged
