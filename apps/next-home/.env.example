# 复制为 .env 并按需修改(生产环境务必改掉这两个密钥)

# SQLite 数据库路径(默认 ./data/zx.db)
DB_PATH=./data/zx.db

# admin 私密留言页密码
ADMIN_PASSWORD=change-me-admin

# 管理员会话签名密钥(改这个会让所有已登录会话失效;建议随机长串)
SESSION_SECRET=change-me-session-secret

# DeepSeek 用量上报接口的共享密钥(请求头 X-Report-Token)
REPORT_TOKEN=change-me-report

# OpenCode 用量:**只能在 admin「Token用量」里配**(oc_sk_ service-account key + Console 地址),
# 代码不读环境变量;详见 docs/OPENCODE-USAGE.md

# 问答机器人:聊天 API Key(覆盖 admin 里存的;embedding 用 CHATBOT_EMBED_API_KEY)
# CHATBOT_API_KEY=sk-...
# CHATBOT_EMBED_API_KEY=sk-...
# 灵魂/知识库目录(默认 <仓库>/docker/site-content/chatbot)
# CHATBOT_DIR=./docker/site-content/chatbot

# 访客反馈(应用栏「?」按钮 → 站长邮箱;Resend HTTP API,域名已在 Resend 验证)
# 不设 RESEND_API_KEY 时反馈只存库兜底、不发信
# RESEND_API_KEY=re_...
# 收件邮箱(缺省回退到 admin「个人信息」里的邮箱)
# FEEDBACK_TO=service@zxlumen.cn
# 发件地址(缺省按 DOMAIN 推导 feedback@<domain>)
# FEEDBACK_FROM=feedback@zxlumen.cn

# 四周生灵层:同源代理 /api/luminari/field 转发到 luminari(避免跨域)。
# 缺省 dev 用 http://127.0.0.1:8790、生产用容器名 http://luminari:8790。
# LUMINARI_INTERNAL_URL=http://luminari:8790
# 无 blueprint 时静态封面图的回退基址;缺省 dev http://localhost:8790、生产 https://luminari.<DOMAIN>
# LUMINARI_PUBLIC_URL=https://luminari.zxlumen.cn
