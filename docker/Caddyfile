# RAG 知识库问答 demo(独立容器,需加入 docker_web 网络;见 RAG 仓库 deploy/)
rag.{$DOMAIN} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	reverse_proxy rag:8000
}

# Opentodo 网页版(独立容器,加入 docker_web 网络;见 Opentodo 仓库 web/)
todo.{$DOMAIN} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		# 会被主站用 iframe 嵌进应用栏 → 不能 DENY;只放行主站(与自身)内嵌
		Content-Security-Policy "frame-ancestors 'self' https://{$DOMAIN}"
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	reverse_proxy opentodo:8787
}

