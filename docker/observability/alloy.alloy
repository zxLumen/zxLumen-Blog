// ============================================================================
// Grafana Alloy:抓取主机(node-exporter)+ 容器(cAdvisor)+ 应用 /api/metrics,
//   采集 app/caddy 容器日志 → Grafana Cloud(Mimir 指标 / Loki 日志)
// 通过 `docker compose --profile monitoring up -d` 启动;
// 环境变量来自 docker/.env(GRAFANA_* / METRICS_TOKEN)。
// ============================================================================

logging {
  level  = "warn"
  format = "logfmt"
}

// ---------- 远端写入端 ----------

prometheus.remote_write "cloud" {
  endpoint {
    url = sys.env("GRAFANA_METRICS_URL")
    basic_auth {
      username = sys.env("GRAFANA_METRICS_USER")
      password = sys.env("GRAFANA_METRICS_TOKEN")
    }
  }
}

loki.write "cloud" {
  endpoint {
    url = sys.env("GRAFANA_LOGS_URL")
    basic_auth {
      username = sys.env("GRAFANA_LOGS_USER")
      password = sys.env("GRAFANA_LOGS_TOKEN")
    }
  }
}

// ---------- 主机指标(node-exporter,独立容器) ----------

prometheus.scrape "node" {
  targets         = [{ "__address__" = "node-exporter:9100", "job" = "node", "instance" = "zx-vps" }]
  forward_to      = [prometheus.remote_write.cloud.receiver]
  scrape_interval = "30s"
}

// ---------- 容器指标(cAdvisor;白名单 + 保留 name/service,去高基数标签) ----------

prometheus.relabel "cadvisor" {
  forward_to = [prometheus.remote_write.cloud.receiver]

  rule {
    source_labels = ["__name__"]
    regex         = "container_(cpu_usage_seconds_total|memory_working_set_bytes|memory_usage_bytes|memory_rss|memory_cache|network_receive_bytes_total|network_transmit_bytes_total|network_receive_errors_total|network_transmit_errors_total|start_time_seconds|oom_events_total|fs_reads_bytes_total|fs_writes_bytes_total|fs_usage_bytes)"
    action        = "keep"
  }
  // compose service → service 标签(先复制,再在下面连同其它 container_label_* 一起删)
  rule {
    source_labels = ["container_label_com_docker_compose_service"]
    target_label  = "service"
  }
  // 去掉容器 id、镜像名与全部 docker 标签(避免高基数);保留 name(容器名)与 service
  rule {
    regex  = "^(id|image|container_label_.*)$"
    action = "labeldrop"
  }
}

prometheus.scrape "cadvisor" {
  targets         = [{ "__address__" = "cadvisor:8080", "job" = "cadvisor", "instance" = "zx-vps" }]
  forward_to      = [prometheus.relabel.cadvisor.receiver]
  scrape_interval = "60s"
  metrics_path    = "/metrics"
}

// ---------- 应用自定义指标(/api/metrics) ----------

prometheus.scrape "app" {
  targets         = [{ "__address__" = "app:3000", "job" = "zx-app", "instance" = "zx-vps" }]
  forward_to      = [prometheus.remote_write.cloud.receiver]
  scrape_interval = "30s"
  metrics_path    = "/api/metrics"
  basic_auth {
    username = "metrics"
    password = sys.env("METRICS_TOKEN")
  }
}

// ---------- 容器日志(全部容器,按 container/service 标签) → Loki ----------

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "docker_logs" {
  targets = discovery.docker.containers.targets

  // 采集本机全部容器日志(mailserver 等几乎不写 stdout,无噪声)
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/?(.*)"
    target_label  = "container"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
}

loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.docker_logs.output
  forward_to = [loki.write.cloud.receiver]
  labels     = { job = "docker" }
}
