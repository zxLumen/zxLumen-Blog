# 关闭 HTTP/3,释放 UDP 443 交给 Hysteria2(伪装成 QUIC/HTTP3 流量)
{
	servers {
		protocols h1 h2
	}
}

# 主页根域名(需先把 A 记录指向服务器 IP)
{$DOMAIN} {
	encode zstd gzip

	# 访问日志:用于排查「请求是否到达 / 是否超时 / 返回码」,尤其链路卡住时。
	# 写 caddy-data 卷(/data),容器重建不丢;不随 Alloy 外发,避免第三方留存访客 IP。
	log {
		output file /data/access.log {
			roll_size 10MiB
			roll_keep 5
		}
		format json
	}

	# 安全响应头
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# 简历 PDF / 微信二维码:由 Caddy 从挂载目录直接静态服务(不入应用镜像)
	# 新文件放 docker/site-content/ 并 scp 上传即可,无需重建/重启
	handle /resume.pdf {
		root * /srv/site
		file_server
	}
	handle /wechat.png {
		root * /srv/site
		file_server
	}

	# 视频横屏封面:cover:vlog 生成的 /vlog/<vid>.jpg(640x360,来自抖音 origin_cover)
	# 与本地 dev 同路径(本地由 apps/next-home/public/vlog 软链提供)
	handle /vlog/* {
		root * /srv/site
		file_server
	}

	# 右侧应用栏图标:/admin「应用」面板上传的 /apps/<id>.<ext>(浏览器端压到长边 256 的 PNG)
	# 与本地 dev 同路径(本地由 apps/next-home/public/apps 软链提供)
	handle /apps/* {
		root * /srv/site
		file_server
	}

	# 内部指标端点绝不对外暴露(仅 Alloy 经容器内网抓取;纵深防御)
	handle /api/metrics* {
		respond 404
	}

	# 其余都交给 Next 应用
	handle {
		reverse_proxy app:3000
	}
}

# www → 主域 301 跳转(需 www 的 A 记录指向本机,Caddy 自动签证书)
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

# 邮箱 Webmail / 管理后台 → Poste.io(host 网络,监听宿主机 8443)
mail.{$DOMAIN} {
	reverse_proxy host.docker.internal:8443 {
		# 强制把外部 Host 传给 Poste(它按 Host 拼绝对跳转)
		header_up Host {http.request.host}
		header_up X-Forwarded-Host {http.request.host}
		header_up X-Forwarded-Proto {scheme}
		transport http {
			tls_insecure_skip_verify
		}
	}
}

# Bark 推送服务(容器 bark-server,与 caddy 同在 docker_web 网络)
bark.{$DOMAIN} {
	reverse_proxy bark-server:8080
}

# 本地 Grafana(仅本机采集 → 云端数据源;Web 在服务器):basic_auth 保护
grafana.{$DOMAIN} {
	basic_auth {
		admin {$GRAFANA_BASIC_HASH}
	}
	reverse_proxy grafana:3000
}

# 未来项目 demo:每个子域名一条,反代到对应容器
