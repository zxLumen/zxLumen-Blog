{
  "name": "@zx/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./creature": {
      "types": "./dist/creature/index.d.ts",
      "import": "./dist/creature/index.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "files": [
    "dist",
    "src/styles.css"
  ],
  "scripts": {
    "ensure-content": "node scripts/ensure-content.mjs",
    "export:content": "node scripts/export-content.mjs",
    "cover:vlog": "node scripts/vlog-cover.mjs",
    "icons:apps": "node scripts/app-icons.mjs",
    "cover:push": "node scripts/cover-push.mjs",
    "sync:projects": "node scripts/sync-projects.mjs",
    "sync:apps": "node scripts/sync-apps.mjs",
    "seed:chatbot": "node scripts/seed-chatbot.mjs",
    "ai-voice:prep": "node scripts/ai-voice-prep.mjs",
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "test": "npm run build && node --test tests/*.test.ts"
  },
  "peerDependencies": {
    "@mantine/core": "^9.6.2",
    "@mantine/hooks": "^9.6.2",
    "better-sqlite3": ">=11.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "better-sqlite3": "^13.0.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  }
}
