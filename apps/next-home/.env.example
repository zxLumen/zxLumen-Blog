# 复制为 .env 并按需修改(生产环境务必改掉这两个密钥)

# SQLite 数据库路径(默认 ./data/zx.db)
DB_PATH=./data/zx.db

# 测试模式独立库(默认 ./data/zx.test.db;生产容器里指向挂载卷以便持久化)
# DB_TEST_PATH=./data/zx.test.db

# 生产环境默认禁用整站测试模式(NODE_ENV=production 时,仅当显式设为 1 才放行)
# ALLOW_TEST_MODE=1

# admin 私密留言页密码
ADMIN_PASSWORD=change-me-admin

# 管理员会话签名密钥(改这个会让所有已登录会话失效;建议随机长串)
SESSION_SECRET=change-me-session-secret

# DeepSeek 用量上报接口的共享密钥(请求头 X-Report-Token)
REPORT_TOKEN=change-me-report

# OpenCode 用量(可选,不经 admin 也可以用;正式地址为 https://opencode.ai/console)
# OPENCODE_SERVICE_KEY=oc_sk_...
# OPENCODE_CONSOLE_URL=https://opencode.ai/console
