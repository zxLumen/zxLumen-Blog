# =============================================================================
# 站点入口:本文件只保留「全局设置 + 公共片段 + 根站」。
#
# 每个子域一个文件:docker/caddy/sites/<name>.caddy
#   → 容器内被 import /etc/caddy/sites/*.caddy 引入
#   → 新增应用 = 丢一个 .caddy 文件(不用再动这份主配置)
#   → 这些文件由 ci-run.sh 从仓库同步,服务器上手改会被覆盖;路由一律进仓库
#
# 校验:`docker compose run --rm --no-deps caddy caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile`
#
# ⚠️ 注意:全局 options 里的 `log` 是**进程运行日志**(default logger),不是访问日志;
#    访问日志必须在站点块里用 `log`(= 下面的 (accesslog) snippet)。别把 access log 写回全局,
#    那样 `caddy validate` 的报错会进文件、stderr 变空,排查时什么都看不到。
# =============================================================================
{
	# 关闭 HTTP/3,释放 UDP 443 交给 Hysteria2(伪装成 QUIC/HTTP3 流量)
	servers {
		protocols h1 h2
	}
}

# -----------------------------------------------------------------------------
# 公共片段(snippet)。注意:必须定义在下面的 import 之前。
# -----------------------------------------------------------------------------

# 已知凭据/配置探测路径:命中直接 444 断开,不进应用、不产生 404/400 噪音。
# 只匹配明确的敏感文件名或目录,不做 `/api`、`/_next`、静态资源之类的宽泛拦截;
# 因此正常页面、接口、构建产物与 /robots.txt、/sitemap.xml 都不受影响。
(probes) {
	@known_probe {
		path_regexp known_probe `(?i)^/(?:.*/)?(?:\.env(?:[-.~][a-z0-9._~-]*)?|\.git(?:/.*)?|\.git-credentials|\.gitmodules|\.gitlab-ci\.yml|\.github(?:/.*)?|\.aws(?:/.*)?|\.terraform(?:/.*)?|terraform\.tfstate(?:\.[a-z0-9._-]+)?|\.docker(?:/.*)?|\.boto|\.netrc|\.npmrc|\.s3cfg|\.htaccess|\.amplifyrc|\.cursor(?:/.*)?|\.claude(?:/.*)?|dockerfile|docker-compose\.ya?ml|actuator/env|_profiler/phpinfo|phpinfo(?:\.php)?|info\.php|wp-config\.php(?:\.bak)?|wp-content/debug\.log|config\.php(?:\.bak)?|database\.sql|composer\.json|credentials(?:\.(?:json|ini|bak))?|secrets?\.json|auth\.json|settings\.json|settings\.php|appsettings(?:\.[a-z]+)?\.json|aws-exports\.js|sendgrid\.env|config\.env|env(?:\.txt)?|env\.js|env-config\.js|runtime-config\.js|storage/logs/laravel\.log|vendor/composer/installed\.json|server-info|web\.config|sentry\.properties|config/config\.js|config/aws\.yml|config\.json|config\.yaml|config\.js)$`
	}
	# 用 handle 包一层:保证它排在站点末尾的 catch-all handle 之前。
	handle @known_probe {
		respond 444
	}
}

# 访问日志(站点级 `log` = access log;全局 `log` 是运行日志,别混)
# 写 caddy-data 卷(/data),容器重建不丢;不随 Alloy 外发,避免第三方留存访客 IP。
# 多个站点用完全相同配置时 Caddy 会按 writer 配置共享同一个文件句柄,不会互相踩滚动。
(accesslog) {
	import probes
	log {
		output file /data/access.log {
			roll_size 10MiB
			roll_keep 5
		}
		format json
	}
}

# 会被主站用 iframe 嵌进应用栏的应用:不能 X-Frame-Options DENY
(webapp) {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Content-Security-Policy "frame-ancestors 'self' https://{$DOMAIN}"
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

# 同上,但用 + 追加 CSP 而不是覆盖:容器自己已有严格 CSP 时用
# (多条 CSP 头各自独立生效、取交集,正是想要的效果)
(webapp_append) {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		+Content-Security-Policy "frame-ancestors 'self' https://{$DOMAIN}"
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

# 不允许被 iframe 的站点(根站 / 后台类)
(deny) {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

# 补压缩与缺失的安全头,但**不**碰 iframe 限制(交由应用自己决定)。
# 给 Grafana 这类用:Grafana 自己就发 `X-Frame-Options: deny` + `nosniff`
# (allow_embedding=false),但**不做压缩**;首屏 JS/CSS 是 MB 级,压缩对首屏影响很大。
# 不设 XFO → 将来真要 embed,只需把 grafana.ini 的 allow_embedding 打开,不用再改 Caddy。
(secure) {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

# SSE 长连接:必须关闭缓冲(reverse_proxy 内 import sse)
(sse) {
	flush_interval -1
}

# -----------------------------------------------------------------------------
# 子域路由(一应用一文件,见 docker/caddy/sites/)
# -----------------------------------------------------------------------------
import /etc/caddy/sites/*.caddy

# -----------------------------------------------------------------------------
# 根站
# -----------------------------------------------------------------------------
{$DOMAIN} {
	import deny
	import accesslog

	# 搜索引擎入口:由 Caddy 直接返回,避免再落到 Next 产生 404。
	# robots 明确 Allow /,并把 sitemap 指向同域 /sitemap.xml。
	handle /robots.txt {
		header Content-Type "text/plain; charset=utf-8"
		respond <<ROBOTS
User-agent: *
Allow: /
Sitemap: https://{$DOMAIN}/sitemap.xml
ROBOTS 200
	}

	# 主站首页 + 19 个公开子域入口(不含 www/bark/grafana/preview)。
	handle /sitemap.xml {
		header Content-Type "application/xml; charset=utf-8"
		respond <<SITEMAP
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url><loc>https://{$DOMAIN}/</loc><changefreq>daily</changefreq><priority>1.0</priority></url>
  <url><loc>https://attune.{$DOMAIN}/</loc><changefreq>weekly</changefreq><priority>0.8</priority></url>
  <url><loc>https://brain.{$DOMAIN}/</loc><changefreq>weekly</changefreq><priority>0.8</priority></url>
  <url><loc>https://company.{$DOMAIN}/</loc><changefreq>weekly</changefreq><priority>0.8</priority></url>
  <url><loc>https://curling.{$DOMAIN}/</loc><changefreq>weekly</changefreq><priority>0.8</priority></url>
  <url><loc>https://douyu.{$DOMAIN}/</loc><changefreq>weekly</changefreq><priority>0.8</priority></url>
  <url><loc>https://duiwei.{$DOMAIN}/</loc><changefreq>weekly</changefreq><priority>0.8</priority></url>
  <url><loc>https://game.{$DOMAIN}/</loc><changefreq>weekly</changefreq><priority>0.8</priority></url>
  <url><loc>https://luminari.{$DOMAIN}/</loc><changefreq>weekly</changefreq><priority>0.8</priority></url>
  <url><loc>https://mbti.{$DOMAIN}/</loc><changefreq>weekly</changefreq><priority>0.8</priority></url>
  <url><loc>https://orderhub.{$DOMAIN}/</loc><changefreq>weekly</changefreq><priority>0.8</priority></url>
  <url><loc>https://photo.{$DOMAIN}/</loc><changefreq>weekly</changefreq><priority>0.8</priority></url>
  <url><loc>https://pocket.{$DOMAIN}/</loc><changefreq>weekly</changefreq><priority>0.8</priority></url>
  <url><loc>https://rag.{$DOMAIN}/</loc><changefreq>weekly</changefreq><priority>0.8</priority></url>
  <url><loc>https://code-sandbox.{$DOMAIN}/</loc><changefreq>weekly</changefreq><priority>0.8</priority></url>
  <url><loc>https://stock.{$DOMAIN}/</loc><changefreq>weekly</changefreq><priority>0.8</priority></url>
  <url><loc>https://todo.{$DOMAIN}/</loc><changefreq>weekly</changefreq><priority>0.8</priority></url>
  <url><loc>https://wear.{$DOMAIN}/</loc><changefreq>weekly</changefreq><priority>0.8</priority></url>
  <url><loc>https://yijing.{$DOMAIN}/</loc><changefreq>weekly</changefreq><priority>0.8</priority></url>
  <url><loc>https://zuiti.{$DOMAIN}/</loc><changefreq>weekly</changefreq><priority>0.8</priority></url>
</urlset>
SITEMAP 200
	}

	# 简历 PDF / 微信二维码:由 Caddy 从挂载目录直接静态服务(不入应用镜像)
	# 新文件放 docker/site-content/ 并 scp 上传即可,无需重建/重启
	handle /resume.pdf {
		root * /srv/site
		file_server
	}
	handle /wechat.png {
		root * /srv/site
		file_server
	}

	# 视频横屏封面:cover:vlog 生成的 /vlog/<vid>.jpg(640x360,来自抖音 origin_cover)
	# 与本地 dev 同路径(本地由 apps/next-home/public/vlog 软链提供)
	handle /vlog/* {
		root * /srv/site
		file_server
	}

	# 右侧应用栏图标:/admin「应用」面板上传的 /apps/<id>.<ext>(浏览器端压到长边 256 的 PNG)
	# 与本地 dev 同路径(本地由 apps/next-home/public/apps 软链提供)
	handle /apps/* {
		root * /srv/site
		file_server
	}

	# 内部指标端点绝不对外暴露(仅 Alloy 经容器内网抓取;纵深防御)
	handle /api/metrics* {
		respond 404
	}

	# 其余都交给 Next 应用
	handle {
		reverse_proxy app:3000
	}
}
