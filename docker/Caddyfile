# 私有:你 Mac 上的 opencode(经 SSH 反向隧道暴露到 host.docker.internal:4096)。
# 仅站长用(Basic 认证由 opencode 自身提供),不进应用栏。见 Opencode-Pocket 仓库。
pocket.{$DOMAIN} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		# 若被主站 iframe 嵌入,只放行主站(与自身)内嵌
		Content-Security-Policy "frame-ancestors 'self' https://{$DOMAIN}"
		-Server
	}

	# WebUI 本地补丁(2026-10-21):首屏消息 40 → 20。显式传 limit 的客户端(TUI/全量加载)不受影响。
	@msgInitial {
		path_regexp ^/api/session/[^/]+/message$
		query limit=40
	}
	rewrite @msgInitial {http.request.uri.path}?limit=20&order=desc

	# WebUI 本地补丁:事件流连接超时 2s → 8s。
	# /sw.js 换成直通 SW(清旧缓存 + 强制 runtime 走网络)，并替换 runtime 资源。
	# opencode 升级后 asset 哈希会变，需要重新打补丁。
	handle /sw.js {
		root * /srv/site/oc-patch
		file_server
		header Cache-Control "no-cache"
	}
	handle /_assets/runtime-BfldUWqN.js {
		root * /srv/site/oc-patch
		file_server
		header Cache-Control "no-cache"
	}

	# App 图片上传中继：/pocketd/upload -> pocketd(8788)/upload
	# 说明：pocketd 跑在宿主机(0.0.0.0:8788)，容器经 host.docker.internal 访问。
	handle /pocketd/* {
		uri strip_prefix /pocketd
		reverse_proxy host.docker.internal:8788
	}
	handle {
		reverse_proxy host.docker.internal:4096 {
			# SSE(/api/event)必须关闭缓冲
			flush_interval -1
		}
	}
}

# 公开:访客沙盒 opencode web(code-sandbox.{$DOMAIN})。
# 实现整体在 Opencode-Pocket 仓库(镜像 / compose / 边缘 Caddy / 部署脚本),访客锁定的
# 全部逻辑都在那边;这里只做 TLS 与转发到沙盒自带的边缘 Caddy。
# 详见 https://github.com/zxLumen/Opencode-Pocket/blob/main/docs/vps-sandbox.md
code-sandbox.{$DOMAIN} {
	reverse_proxy sandbox-caddy:80 {
		# SSE(/api/event)必须关闭缓冲
		flush_interval -1
	}
}

# 观众在沙盒里做的网站(独立域名;由 Opencode-Pocket ci-run.sh 自愈补上)
preview.{$DOMAIN} {
	rewrite * /preview{path}
	reverse_proxy sandbox-caddy:80
}

# Agent Brain 网页端(独立容器,加入 docker_web 网络;见 agentbrain 仓库 web/)
# 纯静态站点:无后端、无环境变量、不收集数据。容器 agentbrain-web 监听 80。
brain.{$DOMAIN} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		# 会被主站用 iframe 嵌进应用栏 → 不能 DENY;只放行主站(与自身)内嵌。
		# 用 + 追加而不是覆盖:容器自己已有一条严格 CSP(脚本/连接/表单全部锁死),
		# 这里只补 frame-ancestors。多条 CSP 头各自独立生效、取交集,正是想要的效果。
		+Content-Security-Policy "frame-ancestors 'self' https://{$DOMAIN}"
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	reverse_proxy brain:80
}

# 嘴替(Next.js,跑在宿主机 3100)
zuiti.{$DOMAIN} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	@owner_login path /login* /api/auth/*
	basic_auth @owner_login {
		admin $2a$14$ioLmRW0rx0KVzDxdlVeRxOHkOEBYBNPEan3g0XzAwLiIMrtvKCztW
	}

	reverse_proxy host.docker.internal:3100
}
