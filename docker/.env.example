# 复制为 docker/.env,按需修改

# 你的域名(Caddy 自动申请 HTTPS 证书,A 记录需先指向服务器)
DOMAIN=example.com

# Let's Encrypt 通知邮箱
ACME_EMAIL=you@example.com

# admin 密码(务必修改)
ADMIN_PASSWORD=change-me-admin

# 管理员会话签名密钥(务必改成随机长串;改动会使所有已登录会话失效)
SESSION_SECRET=change-me-session-secret

# DeepSeek 用量上报密钥(务必修改)
REPORT_TOKEN=change-me-report

# ---------------------------------------------------------------------------
# 监控(可选,仅 `--profile monitoring` 时用到)
# ---------------------------------------------------------------------------

# /api/metrics 的内部访问令牌(仅 Alloy 抓取时携带;随机长串)
METRICS_TOKEN=change-me-metrics-token

# Grafana Cloud —— 指标(Mimir)remote_write 凭据
GRAFANA_METRICS_URL=https://prometheus-prod-XX-prod-ap-southeast-1.grafana.net/api/prom/push
GRAFANA_METRICS_USER=000000
GRAFANA_METRICS_TOKEN=glc_change_me

# Grafana Cloud —— 日志(Loki)push 凭据
GRAFANA_LOGS_URL=https://logs-prod-XXX.grafana.net/loki/api/v1/push
GRAFANA_LOGS_USER=000000
GRAFANA_LOGS_TOKEN=glc_change_me

# Sentry(EU)—— 仅错误追踪;留空即完全关闭
# 服务端 / SSR / Edge:运行时读取
SENTRY_DSN=
# 前端:须在「构建期」注入(CI 构建参数);不设则仅服务端上报
# NEXT_PUBLIC_SENTRY_DSN=
# 以下放 GitHub Actions Secret(勿写这里):
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=28a6cde5af7c
# SENTRY_PROJECT=javascript-nextjs
