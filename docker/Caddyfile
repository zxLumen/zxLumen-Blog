# 主页根域名(需先把 A 记录指向服务器 IP)
{$DOMAIN} {
	encode zstd gzip

	# 安全响应头
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	reverse_proxy app:3000
}

# www → 主域 301 跳转(需 www 的 A 记录指向本机,Caddy 自动签证书)
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

# 邮箱 Webmail / 管理后台 → Poste.io(host 网络,监听宿主机 8443)
mail.{$DOMAIN} {
	reverse_proxy host.docker.internal:8443 {
		# 强制把外部 Host 传给 Poste(它按 Host 拼绝对跳转)
		header_up Host {http.request.host}
		header_up X-Forwarded-Host {http.request.host}
		header_up X-Forwarded-Proto {scheme}
		transport http {
			tls_insecure_skip_verify
		}
	}
}

# Bark 推送服务(容器 bark-server,与 caddy 同在 docker_web 网络)
bark.{$DOMAIN} {
	reverse_proxy bark-server:8080
}

