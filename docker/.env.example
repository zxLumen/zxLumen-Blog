# 复制为 docker/.env,按需修改

# 你的域名(Caddy 自动申请 HTTPS 证书,A 记录需先指向服务器)
DOMAIN=example.com

# Let's Encrypt 通知邮箱
ACME_EMAIL=you@example.com

# admin 密码(务必修改)
ADMIN_PASSWORD=change-me-admin

# 管理员会话签名密钥(务必改成随机长串;改动会使所有已登录会话失效)
SESSION_SECRET=change-me-session-secret

# DeepSeek 用量上报密钥(务必修改)
REPORT_TOKEN=change-me-report
